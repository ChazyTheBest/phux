# npm must not call the live registry advisory endpoint from CI or local
# gates: the audit bulk endpoint has returned 503s mid-lane (observed
# 2026-09-04, twice in 35 minutes), failing gates that had nothing to do
# with the change under test and leaving no reproducible cause. License and
# advisory hygiene is cargo-deny's contract, not npm audit's.
#
# npm resolves this project .npmrc from any cwd inside this repository (it
# walks up from the invocation directory), so it covers `npm ci` in the
# integration gates, test-pack.mjs's consumer install, and the release
# lanes' verify installs. Explicit --no-audit --no-fund flags at call sites
# stay; they are belt-and-braces for invocations made from temp directories
# outside the tree.
audit=false
fund=false
